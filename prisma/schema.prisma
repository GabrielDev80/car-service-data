generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//Enums
enum UserRole {
  superuser
  admin
  user
}

enum DocumentType {
  seguro
  patente
  revision_tecnica
  prueba_hidraulica
  ruta
  licencia_nacional
  licencia_cargas_curso
  licencia_cargas_psicofisico
  otro
}

// Company
model Company {
  id              String  @id  @default(uuid())
  
  name            String
  phone           String
  email           String  @unique
  password        String

  // Relations
  users           User[]
  vehicles        Vehicle[]

  // Trial mode
  trialStartDate  DateTime?
  trialEndDate    DateTime?
  isLicensed      Boolean @default(false)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// User
model User {
  id              String  @id  @default(uuid())

  first_name      String
  last_name       String
  username        String?  @unique
  phone           String
  email           String  @unique
  password        String

  role            UserRole  @default(user)
  companyId       String?
  company         Company?  @relation(fields: [companyId], references: [id])

  vehicles        Vehicle[]

  license         License?
  linti           Linti?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Licenses
model License {
  id              String   @id @default(uuid())
  
  user            User  @relation(fields: [userId], references: [id])
  userId          String   @unique
  
  licenseClass    String
  expireDate      DateTime
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Linti {
  id              String   @id @default(uuid())
  
  user            User  @relation(fields: [userId], references: [id])
  userId          String   @unique
  
  psichoPhysicalTest     DateTime?
  expPsichoPhysicalTest  DateTime?
  course                 DateTime?
  expCourse              DateTime?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// Vehicle
model Vehicle {
  id        String    @id @default(uuid())

  make      String
  model     String
  year      Int
  color     String
  vehicle_registration String @unique

  // owner: usuario
  ownerId   String?
  owner     User? @relation(fields: [ownerId], references: [id])

  // empresa (opcional)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  thumbnails String[]

  services      Service[]
  documentation Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Services
model Service {
  id           String      @id @default(uuid())
  vehicle      Vehicle  @relation(fields: [vehicleId], references: [id])
  vehicleId    String

  service_date         DateTime
  service_type         String
  service_description  String
  service_mileage      Int
  service_cost         Float? @default(0)
  service_location     String
  next_service_mileage Int?
  next_service_date    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Documents
model Document {
  id           String          @id @default(uuid())
  vehicle      Vehicle      @relation(fields: [vehicleId], references: [id])
  vehicleId    String

  document_name  DocumentType
  description    String?
  expiration_date DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}